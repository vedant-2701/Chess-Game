# ============================================================
# chess-server environment configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# Server
SERVER_PORT=8080

# Logging — valid values: debug, info, warn, error
LOG_LEVEL=debug

# Database
# Matches the postgres service defined in docker-compose.yml.
# For the migrate CLI, use this URL directly.
# For the Go app, this is passed to pgxpool.New().
DATABASE_URL=postgres://chess:chess@localhost:5432/chess?sslmode=disable

# JWT signing secret — CHANGE THIS before running.
# Generate a secure value with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-minimum-32-characters

# Redis (Phase 2 — routing directory: ownership + liveness keys, not an
# EventBus. See DECISIONS_LOG_PHASE_2.md ADR-021/ADR-023.)
# Matches the redis service defined in docker-compose.yml. Host:port form,
# not a redis:// URL — passed directly to go-redis's Options.Addr.
REDIS_ADDR=localhost:6379

# INSTANCE_ID — a unique identifier for this replica, required in any
# multi-instance (Phase 2) deployment. Used as the value stored under the
# game:{gameID} ownership key and as the key for instance_alive:{instanceID}.
# No safe default across replicas: two replicas silently sharing an ID would
# corrupt routing. Set explicitly per replica, e.g. server-1, server-2 — for
# single-instance local dev, any unique value works.
INSTANCE_ID=instance-1

# Matchmaking (Phase 3 — pairing loop + matchmaking-service reporting. See
# DECISIONS_LOG_PHASE_3.md ADR-032/ADR-033/ADR-034.)
#
# MATCHMAKING_SERVICE_ADDR: host:port of matchmaking-service's gRPC endpoint
# (Phase 3 Step 4 — a separate deployable, cmd/matchmaking-service). Left
# EMPTY or unset, this instance simply does not start internal/matchmaking's
# pairing loop at all — not an error, a deliberate opt-in gate. Every
# existing single-instance and Phase-2 deployment can leave this unset and is
# completely unaffected. In docker-compose.yml's cluster profile this is set
# to matchmaking-service:9090 — port 9090, not 8081; 8081 is
# matchmaking-service's separate HTTP/SSE listener (MATCHMAKING_SVC_PORT
# below), a different protocol on a different port from this one.
MATCHMAKING_SERVICE_ADDR=

# MATCHMAKING_SHARED_SECRET: the trust-boundary secret checked by
# internal/rpc's gRPC interceptor (ADR-033) — required only when
# MATCHMAKING_SERVICE_ADDR is set, and must match matchmaking-service's own
# copy of this same value exactly. Generate with: openssl rand -hex 32
MATCHMAKING_SHARED_SECRET=

# MATCHMAKING_PAIRING_INTERVAL_MS: how often each instance's pairing loop
# ticks (ZCARD/ZPOPMIN against the shared queue). Optional — defaults to 500
# if unset or non-positive.
MATCHMAKING_PAIRING_INTERVAL_MS=500

# MATCHMAKING_SVC_PORT: the port matchmaking-service's own HTTP/SSE
# listener binds to (Phase 3 Step 4, cmd/matchmaking-service — a separate
# binary and container from chess-server itself, sharing this same .env
# file for docker-compose's sake). Optional — defaults to 8081, matching
# nginx.conf's /matchmaking location block's own hardcoded upstream
# assumption. Not read by cmd/server at all.
MATCHMAKING_SVC_PORT=8081

# MATCHMAKING_SVC_GRPC_PORT: the port matchmaking-service's MatchReportService
# gRPC listener binds to — a separate protocol and port from
# MATCHMAKING_SVC_PORT's HTTP/SSE listener above. Optional — defaults to
# 9090, matching MATCHMAKING_SERVICE_ADDR's docker-compose.yml value
# (matchmaking-service:9090). Not read by cmd/server; only
# cmd/matchmaking-service reads this one.
MATCHMAKING_SVC_GRPC_PORT=9090

# MATCHMAKING_QUEUE_TIMEOUT_SECONDS: how long a player may wait in the
# matchmaking queue before matchmaking-service's sweep goroutine removes
# them and reports MATCHMAKING_FAILED (reason: QUEUE_TIMEOUT) —
# DECISIONS_LOG_PHASE_3.md ADR-036. Optional — defaults to 30 if unset. Only
# cmd/matchmaking-service reads this one.
MATCHMAKING_QUEUE_TIMEOUT_SECONDS=30

# CONNECT_CLAIMS_TTL_SECONDS: ConnectClaims' actual lifetime (PHASE_3.md
# Step 5 — fixes a pre-existing bug where this was hardcoded at 60s in
# internal/auth despite that constant's own doc comment always claiming
# 10s). Deliberately short: this token only needs to survive the gap between
# a resolve response and the client's immediately-following WebSocket dial,
# not a reconnection window (DECISIONS_LOG_PHASE_2.md ADR-022). Optional —
# defaults to 10 if unset. Only cmd/server reads this one.
CONNECT_CLAIMS_TTL_SECONDS=10

# MATCHMAKING_CLAIMS_TTL_SECONDS: MatchmakingClaims' actual lifetime
# (PHASE_3.md Step 5, DECISIONS_LOG_PHASE_3.md ADR-036 §15's addendum).
# Optional — defaults to 10 if unset. Only cmd/matchmaking-service reads
# this one.
MATCHMAKING_CLAIMS_TTL_SECONDS=10
